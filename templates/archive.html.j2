<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CEEMEA Morning Brief · Archive</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Newsreader:opsz,wght@6..72,600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f4ef;--paper:#fffdf9;--ink:#1b1f24;--muted:#5d6670;--line:#e2ddd3;--accent:#0f4c5c}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#121417;--paper:#1a1d21;--ink:#e7e4de;--muted:#9aa3ac;--line:#2c3137;--accent:#7fc4d4}}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 "IBM Plex Sans",system-ui,sans-serif}
.wrap{max-width:680px;margin:0 auto;padding:32px 20px}
h1{font:600 30px Newsreader,Georgia,serif;margin:0 0 4px}
a{color:var(--accent)}
ul{list-style:none;padding:0;background:var(--paper);border:1px solid var(--line);border-radius:8px}
li{padding:10px 14px;border-bottom:1px solid var(--line)} li:last-child{border-bottom:0}
</style>
</head>
<body><div class="wrap">
<p><a href="../index.html">← Latest brief</a></p>
<h1>Archive</h1>
<ul>{% for d in dates %}<li><a href="{{ d }}.html">{{ long_date(d) }}</a></li>{% endfor %}</ul>
</div></body>
</html>
