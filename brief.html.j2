<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CEEMEA Morning Brief · {{ report.run_date }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6f4ef; --paper:#fffdf9; --ink:#1b1f24; --muted:#5d6670; --line:#e2ddd3;
  --accent:#0f4c5c; --accent-soft:#e3eef0; --warn:#9a5b00; --warn-soft:#fbf0dc; --up:#1d6b3a; --down:#a12a2a;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#121417; --paper:#1a1d21; --ink:#e7e4de; --muted:#9aa3ac; --line:#2c3137;
  --accent:#7fc4d4; --accent-soft:#1f3238; --warn:#e9b45a; --warn-soft:#33291a; --up:#6cc28d; --down:#e88a8a;}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 "IBM Plex Sans",system-ui,sans-serif}
a{color:var(--accent)}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header.top{border-bottom:1px solid var(--line);background:var(--paper)}
header.top .wrap{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding-top:22px;padding-bottom:18px;flex-wrap:wrap}
.kicker{font:500 11.5px/1 "IBM Plex Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
h1{font:600 34px/1.1 Newsreader,Georgia,serif;margin:8px 0 0;letter-spacing:-.01em}
.date{color:var(--muted);font-size:14px}
nav{display:flex;gap:16px}nav a{font-size:13.5px;text-decoration:none}
.banner{background:var(--warn-soft);color:var(--warn);font-weight:600;text-align:center;padding:8px;font-size:13px;letter-spacing:.04em}
.status{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 6px}
.pill{font:500 12px/1 "IBM Plex Mono",monospace;padding:7px 10px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--muted)}
.pill b{color:var(--ink);font-weight:500}
.pill.warn{border-color:var(--warn);color:var(--warn)}
h2{font:600 22px/1.2 Newsreader,Georgia,serif;margin:34px 0 12px}
.table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--paper)}
table{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}
th,td{padding:9px 12px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th{font:500 11px/1.3 "IBM Plex Mono",monospace;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--paper);vertical-align:bottom}
th:first-child,td:first-child{text-align:left}
tr:last-child td{border-bottom:0}
td .reg{display:block;font-size:11.5px;color:var(--muted)}
.neg{color:var(--down)} .alert{color:var(--warn);font-weight:600}
.changes{list-style:none;padding:0;margin:0;background:var(--paper);border:1px solid var(--line);border-radius:8px}
.changes li{padding:10px 14px;border-bottom:1px solid var(--line)}
.changes li:last-child{border-bottom:0}
.changes .c{font-weight:600;margin-right:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(480px,1fr));gap:16px}
@media (max-width:560px){.grid{grid-template-columns:1fr}}
.card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:18px 20px;display:flex;flex-direction:column}
.card header{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.card h3{font:600 20px/1.2 Newsreader,Georgia,serif;margin:0}
.meta{font:500 11px/1 "IBM Plex Mono",monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.lede{font-weight:600;margin:10px 0 6px}
.card ul.b{margin:6px 0 0;padding-left:18px}
.card ul.b li{margin:6px 0}
.cite{font:500 10.5px/1 "IBM Plex Mono",monospace;background:var(--accent-soft);color:var(--accent);padding:2px 5px;border-radius:4px;text-decoration:none;margin-left:3px;white-space:nowrap}
.flag{display:block;margin-top:3px;font-size:12.5px;color:var(--warn);background:var(--warn-soft);padding:3px 8px;border-radius:4px}
.angle{margin-top:12px;padding:10px 12px;border-left:3px solid var(--accent);background:var(--accent-soft);font-size:14px}
.angle b{font:500 11px/1 "IBM Plex Mono",monospace;text-transform:uppercase;letter-spacing:.06em;display:block;margin-bottom:4px;color:var(--accent)}
.note{font-size:12.5px;color:var(--warn);margin-top:8px}
details{margin-top:12px;font-size:13px}
summary{cursor:pointer;color:var(--muted)}
details ol{padding-left:0;list-style:none;margin:8px 0 0}
details li{margin:5px 0}
details .sid{font:500 11px "IBM Plex Mono",monospace;color:var(--accent);margin-right:6px}
details .pub{color:var(--muted)}
footer{margin:40px 0 50px;padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
footer h4{font:600 15px Newsreader,Georgia,serif;color:var(--ink);margin:0 0 6px}
@media print{nav,.status,details{display:none}.card{break-inside:avoid}body{background:#fff}}
</style>
</head>
<body>
{% if report.label %}<div class="banner">{{ report.label }}</div>{% endif %}
<header class="top"><div class="wrap">
  <div>
    <div class="kicker">Emerging markets debt · CEEMEA</div>
    <h1>Morning Brief</h1>
    <div class="date">{{ when }}</div>
  </div>
  <nav><a href="{{ base }}index.html">Latest</a><a href="{{ base }}archive/index.html">Archive</a><a href="#method">Method</a></nav>
</div></header>

<main class="wrap">
  <div class="status">
    <span class="pill">Summaries <b>{{ "LLM · " ~ report.method[4:] if report.method.startswith("llm") else "extractive (no LLM)" }}</b></span>
    <span class="pill">News <b>{{ report.status.news }}</b></span>
    <span class="pill">IMF <b>{{ report.status.imf }}</b></span>
    <span class="pill">BIS <b>{{ report.status.bis }}</b></span>
    <span class="pill">FX <b>{{ report.status.fx }}</b></span>
    <span class="pill {{ 'warn' if report.flags }}">Flags <b>{{ report.flags }}</b> / {{ report.bullets }} bullets</span>
    {% if report.previous %}<span class="pill">Compared with <b>{{ report.previous }}</b></span>{% endif %}
  </div>

  <h2>Dashboard</h2>
  <div class="table-scroll"><table>
    <thead><tr>
      <th>Country</th>
      {% for ind, m in cfg.imf_indicators.items() %}<th>{{ m.label }}<br>{{ year }}, {{ m.unit }}</th>{% endfor %}
      <th>Policy rate<br>BIS, %</th><th>FX<br>per USD</th><th>Flags</th>
    </tr></thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <td><a href="#{{ r.iso3 }}">{{ r.name }}</a><span class="reg">{{ r.region }}</span></td>
        {% for ind in cfg.imf_indicators %}{% set v = r.imf[ind] %}<td class="{{ 'neg' if v is not none and v < 0 }}">{{ v|fmt }}</td>{% endfor %}
        <td>{% if r.rate %}{{ r.rate.rate|fmt(2) }}{% else %}<span class="reg">n/a</span>{% endif %}</td>
        <td class="{{ 'alert' if r.fx_alert }}" title="{{ r.fx_alert }}">{{ r.fx|fmt(r.fx < 10 and 3 or 1) if r.fx else '–' }} <span class="reg" style="display:inline">{{ r.ccy }}</span></td>
        <td class="{{ 'alert' if r.flags }}">{{ r.flags or '' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="date" style="font-size:12.5px">IMF figures are World Economic Outlook forecasts for {{ year }}. Policy rates are BIS monthly series{% set nob = cfg.countries|selectattr("bis","equalto","")|map(attribute="name")|list %}{% if nob %} ({{ nob|join(", ") }} not covered by BIS){% endif %}. FX from open.er-api.com.</p>

  <h2>What changed since the last brief</h2>
  {% if all_changes %}
  <ul class="changes">
    {% for name, c in all_changes %}<li><span class="c">{{ name }}</span>{{ c.text }}</li>{% endfor %}
  </ul>
  {% else %}
  <p class="date">{{ "No data changes: policy rates, FX moves over 1% and IMF forecasts are unchanged." if report.previous else "First run: changes are measured from the next brief onwards." }}</p>
  {% endif %}

  <h2>Countries</h2>
  <div class="grid">
  {% for b in briefs %}
    <article class="card" id="{{ b.country.iso3 }}">
      <header><h3>{{ b.country.name }}</h3><span class="meta">{{ b.country.region }} · {{ b.articles|length }} source{{ "" if b.articles|length == 1 else "s" }}</span></header>
      <p class="lede">{{ b.headline }}</p>
      <ul class="b">
      {% for bl in b.bullets %}
        <li>{{ bl.text }}
          {% for s in bl.sources %}{% set a = (b.articles|selectattr("id","equalto",s)|first) %}{% if a %}<a class="cite" href="{{ a.url }}" target="_blank" rel="noopener" title="{{ a.title }}">{{ s }}</a>{% else %}<span class="cite">{{ s }}</span>{% endif %}{% endfor %}
          {% for f in bl.flags %}<span class="flag">⚑ {{ f }}</span>{% endfor %}
        </li>
      {% endfor %}
      </ul>
      {% if b.bond_angle %}
      <div class="angle"><b>Bond angle</b>{{ b.bond_angle }}
        {% for f in b.angle_flags %}<span class="flag">⚑ {{ f }}</span>{% endfor %}</div>
      {% endif %}
      {% if b.note %}<div class="note">{{ b.note }}</div>{% endif %}
      <details>
        <summary>Sources and data</summary>
        <ol>
        {% for a in b.articles %}<li><span class="sid">{{ a.id }}</span><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a> <span class="pub">· {{ a.publisher }} · {{ a.published[:10] }} · relevance {{ a.score }}</span></li>{% endfor %}
        {% for l in b.macro.lines %}<li><span class="sid">DATA</span>{{ l }}</li>{% endfor %}
        </ol>
      </details>
    </article>
  {% endfor %}
  </div>

  <footer id="method">
    <h4>How this brief is made</h4>
    <p>Each morning a Python pipeline pulls headlines (Google News RSS), IMF World Economic Outlook forecasts, BIS policy rates and FX rates for ten CEEMEA sovereigns. Headlines are ranked for bond relevance by a transparent keyword model. Changes since the previous brief (rate moves, FX moves over 1%, IMF revisions) are computed directly from the data. A language model then writes each country summary using only those numbered sources, and must cite a source for every bullet. Before publishing, every figure in the text is checked against the cited source; anything that does not match is flagged ⚑ rather than removed.</p>
    <p>Generated {{ report.generated[:16].replace("T"," ") }} UTC. Research tool only; not investment advice. Headlines are third-party content linked to the original publisher.</p>
  </footer>
</main>
</body>
</html>
